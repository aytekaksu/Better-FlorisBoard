enum.AutocorrectAcceptanceKind=MANUAL,AUTO_CORRECTION,GESTURE
enum.AutocorrectCandidateKind=TYPED,CORRECTION,COMPLETION,NEXT_WORD,EMOJI
enum.AutocorrectCapsMode=UNSPECIFIED,UNSHIFTED,SHIFTED_MANUAL,SHIFTED_AUTOMATIC,CAPS_LOCK
enum.AutocorrectInputMode=TYPING,GESTURE
enum.AutocorrectPluginHostSetting=NONE,GLIDE_ENABLED,GLIDE_SENSITIVE
enum.AutocorrectPluginUiIcon=NONE,SETTINGS,MODEL,DICTIONARY,TUNE,DOWNLOAD,UPLOAD,DELETE,REFRESH,INFO,ADD
enum.AutocorrectPluginUiItemKind=NAVIGATION,SWITCH,SLIDER,CHOICE,TEXT,ACTION,DOCUMENT_IMPORT,DOCUMENT_EXPORT,INFO,PROGRESS,EXTERNAL_LINK
enum.AutocorrectPluginUiSurface=APP,KEYBOARD,BOTH
enum.AutocorrectSeparatorBehavior=DEFAULT,INSERT,OMIT
enum.AutocorrectTextEventKind=COMMIT_TYPED,COMMIT_GESTURE,DELETE_BACKWARD,DELETE_FORWARD
enum.AutocorrectUserDictionaryOperation=QUERY,UPSERT,DELETE
enum.AutocorrectUserDictionaryStatus=OK,UNAVAILABLE,DENIED,INVALID
