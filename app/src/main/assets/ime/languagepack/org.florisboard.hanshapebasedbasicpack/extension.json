    },
    {
      "id": "zh_TW_cangjielarge",
      "label": "中文 (台灣) [倉頡-大字庫] / Chinese (Taiwan) [CANGJIELARGE]",
      "authors": [ "waelwindows", "moonbeamcelery" ],
      "hanShapeBasedKeyCode": "abcdefghijklmnopqrstuvwxyz&"
    }
  ]
