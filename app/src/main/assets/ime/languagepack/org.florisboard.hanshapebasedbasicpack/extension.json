{
  "$": "ime.extension.languagepack",
  "meta": {
    "id": "org.florisboard.hanshapebasedbasicpack",
    "version": "0.0.0",
    "title": "Default barebones Chinese shape-based pack",
    "description": "内置中文形码语言包 / 內建中文形碼語言包 / Built-in Chinese shape-based pack with Zhengma, Boshiamy, and Cangjie Large.",
    "maintainers": [ "patrickgold <patrick@patrickgold.dev>", "waelwindows", "moonbeamcelery" ],
    "homepage": "https://github.com/aytekaksu/Better-FlorisBoard/blob/main/LANGUAGEPACKS-CHINESE.md#default-barebones-chinese-shape-based-pack",
    "license": "apache-2.0"
  },
  "items": [
    {
      "id": "zh_CN_zhengma",
      "label": "中文 (中国) [郑码] / Chinese (China) [ZHENGMA]",
